{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Nertz Royale",
  "version": "1.0.0",
  "identifier": "com.nertzroyale.desktop",
  "build": {
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nertz Royale",
        "width": 1000,
        "height": 1120,
        "minWidth": 420,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
